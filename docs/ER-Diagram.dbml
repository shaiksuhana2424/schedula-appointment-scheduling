
Table users {
  id integer [pk, increment]
  name varchar(100) [not null]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  role varchar(20) [not null]
  created_at timestamp
}

Table patients {
  id integer [pk, increment]
  user_id integer [not null, unique]
  phone varchar(20)
  date_of_birth date
  created_at timestamp
}

Table doctors {
  id integer [pk, increment]
  user_id integer [not null, unique]
  specialization varchar(100) [not null]
  phone varchar(20)
  qualification varchar(255)
  consultation_fee decimal(10,2)
  created_at timestamp
}

Table availabilities {
  id integer [pk, increment]
  doctor_id integer [not null]
  available_date date [not null]
  start_time time [not null]
  end_time time [not null]
  status varchar(20) [not null]
  created_at timestamp
}

Table appointments {
  id integer [pk, increment]
  patient_id integer [not null]
  doctor_id integer [not null]
  availability_id integer [not null]
  reason text
  status varchar(20) [not null]
  created_at timestamp
}

Ref: patients.user_id > users.id
Ref: doctors.user_id > users.id
Ref: availabilities.doctor_id > doctors.id
Ref: appointments.patient_id > patients.id
Ref: appointments.doctor_id > doctors.id
Ref: appointments.availability_id > availabilities.id
